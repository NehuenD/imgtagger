{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window - includes fs access for thumbnails",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-recursive",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "/**"
        }
      ]
    }
  ]
}
